# Variables para docker compose (copia este archivo como .env)
# Tu PostgreSQL local, visto desde Docker. Cambia TU_PASSWORD por tu contraseña de postgres.
DATABASE_URL=postgres://postgres:TU_PASSWORD@host.docker.internal:5432/interfaces?sslmode=disable
# Mínimo 32 caracteres aleatorios
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-123456
